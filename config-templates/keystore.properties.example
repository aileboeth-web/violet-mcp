# 单一密钥签名模板（全新环境 / 分支项目使用）。
# 用法：复制为 signing/keystore.properties 并填写自己的密钥；signing/ 已被 .gitignore 排除，不会进入仓库或交接包。
# 生成密钥：
#   keytool -genkeypair -keystore signing/my-release.jks -storetype PKCS12 -alias my-release \
#     -keyalg EC -groupname secp256r1 -validity 10000 -dname "CN=My Name"
# 注意：本项目官方版本已做过密钥轮换（见 rotation.properties.example 和 docs/SIGNING_KEY_INCIDENT.md），
#       用你自己的密钥签出的 APK 不能覆盖安装官方版本，需要先卸载。
storeFile=signing/my-release.jks
storePassword=CHANGE_ME
keyAlias=my-release
keyPassword=CHANGE_ME
